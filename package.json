{
  "name": "inprogress",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Live task tree beside Claude Code, kept current by Claude",
  "bin": {
    "inprogress": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "node scripts/build-to.mjs .build",
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "test:smoke": "node scripts/build-to.mjs .build --node-only && vitest run --config vitest.smoke.config.ts",
    "test:e2e": "node scripts/build-to.mjs .build && playwright test",
    "claude:install": "node dist/cli/main.js claude-install",
    "claude:uninstall": "node dist/cli/main.js claude-uninstall",
    "deploy": "node scripts/deploy.mjs",
    "rollback": "node scripts/deploy.mjs --rollback"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "better-sqlite3": "^11.10.0",
    "fastify": "^5.12.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource/doto": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "@xyflow/react": "^12.12.0",
    "dompurify": "^3.4.16",
    "marked": "^14.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^2.1.9"
  }
}
